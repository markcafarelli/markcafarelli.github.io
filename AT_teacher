          • Type: <strong>Web app</strong><br>
          • Execute as: <strong>Me</strong><br>
          • Who has access: <strong>Anyone</strong><br>
          Click Deploy, authorize when prompted, then copy the Web App URL.</p>
        </div>
      </div>

      <div class="setup-step">
        <div class="step-num">5</div>
        <div class="step-content">
          <h4>Paste URL into Settings</h4>
          <p>Click the ⚙️ icon in the top bar, paste your Web App URL into the Apps Script URL field, and click Save Settings. You're ready to go!</p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ═══ TOAST ═══ -->
<div class="toast" id="toast"></div>

<script>
// ══════════════════════════════════════════
//  CONSTANTS
// ══════════════════════════════════════════
const PASSWORD        = '8thgrade2627';
const CLASSES         = ['Science 8','Math 8','Algebra I','Honors Algebra I','Spanish II','Civics','English 8'];
const ALL_PERIODS     = ['A','B','C','D','E','F','G'];
const ENGAGEMENTS     = ['Required','Optional'];
const ASSIGNMENT_TYPES = ['Homework','Quiz / Test','Project','Classwork','Lab','Extra Credit'];
const QUARTERS        = ['Quarter 1','Quarter 2','Quarter 3','Quarter 4'];
const WHERE_OPTS      = ['Google Classroom','Keep in Binder','Paper - turn in bin','No submission needed'];

const APPS_SCRIPT_CODE = `const SHEET_ID = 'YOUR_SHEET_ID_HERE';
const PASSWORD = '8thgrade2627';
const HEADERS  = ['ID','Block','Assignment Name','Engagement','Assignment Type','Quarter','Date Assigned','Date Due','Where to Submit','Notes','Resources'];

function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    if (data.password !== PASSWORD) return respond({success:false,error:'Unauthorized'});
    const ss = SpreadsheetApp.openById(SHEET_ID);
    let result;
    if      (data.action === 'add')    result = addRows(ss, data.className, data.rows);
    else if (data.action === 'update') result = updateRows(ss, data.className, data.rows);
    else if (data.action === 'delete') result = deleteById(ss, data.className, data.assignmentId);
    else if (data.action === 'get')    result = getRows(ss, data.className);
    else result = {success:false,error:'Unknown action'};
    return respond(result);
  } catch(err) { return respond({success:false,error:err.message}); }
}

function doGet(e) {
  try {
    const p = e.parameter;
    if (p.password !== PASSWORD) return respond({success:false,error:'Unauthorized'});
    const ss = SpreadsheetApp.openById(SHEET_ID);
    return respond(getRows(ss, p.className));
  } catch(err) { return respond({success:false,error:err.message}); }
}

function respond(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function getOrCreateSheet(ss, className) {
  let sheet = ss.getSheetByName(className);
  if (!sheet) {
    sheet = ss.insertSheet(className);
    sheet.appendRow(HEADERS);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function addRows(ss, className, rows) {
  const sheet = getOrCreateSheet(ss, className);
  rows.forEach(r => sheet.appendRow([r.id,r.block,r.assignmentName,r.engagement,r.assignmentType,r.quarter,r.dateAssigned,r.dateDue,r.whereToSubmit,r.notes,r.resources]));
  return {success:true,count:rows.length};
}

function updateRows(ss, className, rows) {
  const sheet = getOrCreateSheet(ss, className);
  const id    = rows[0].id;
  deleteById(ss, className, id);
  rows.forEach(r => sheet.appendRow([r.id,r.block,r.assignmentName,r.engagement,r.assignmentType,r.quarter,r.dateAssigned,r.dateDue,r.whereToSubmit,r.notes,r.resources]));
  return {success:true};
}

function deleteById(ss, className, assignmentId) {
  const sheet = getOrCreateSheet(ss, className);
  const data  = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][0]) === String(assignmentId)) sheet.deleteRow(i + 1);
  }
  return {success:true};
}

function formatDateCell(val) {
  if (val instanceof Date) {
    const y = val.getFullYear();
    const m = String(val.getMonth()+1).padStart(2,'0');
    const d = String(val.getDate()).padStart(2,'0');
    return y+'-'+m+'-'+d;
  }
  return String(val===null||val===undefined?'':val);
}
function getRows(ss, className) {
  const sheet = ss.getSheetByName(className);
  if (!sheet) return {success:true,rows:[]};
  const vals = sheet.getDataRange().getValues();
  if (vals.length <= 1) return {success:true,rows:[]};
  const hdrs = vals[0];
  const dateCols = ['Date Assigned','Date Due'];
  return {success:true, rows: vals.slice(1).map(r => {
    const o = {};
    hdrs.forEach((h,i) => { o[h] = dateCols.includes(h) ? formatDateCell(r[i]) : String(r[i]===null||r[i]===undefined?'':r[i]); });
    return o;
  })};
}`;

// ══════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════
let currentClass  = CLASSES[0];
let currentMode   = 'create';
let settings      = loadSettings();

// Create form
let selectedPeriods = [];
let sharedResources = []; // [{label,url}]
let blockOverrides  = {}; // {A:{dateDue,notes,resources}}
let editingId       = null; // null = new, string = editing existing

// Edit mode
let editAssignments = []; // grouped by ID
let editSelectedId  = null;
let quarterFilter   = 'all';

// ══════════════════════════════════════════
//  STORAGE
// ══════════════════════════════════════════
function loadSettings() {
  try {
    return JSON.parse(localStorage.getItem('apSettings') || '{}');
  } catch { return {}; }
}
function saveSettingsToStorage() {
  localStorage.setItem('apSettings', JSON.stringify(settings));
}
function getScriptUrl() { return settings.scriptUrl || ''; }
function getClassPeriods(cls) { return (settings.classPeriods || {})[cls] || []; }
function getDefaultPeriods(cls) { return [...getClassPeriods(cls)]; }

// ══════════════════════════════════════════
//  AUTH
// ══════════════════════════════════════════
function checkAuth() {
  const val = document.getElementById('pw-input').value;
  if (val === PASSWORD) {
    document.getElementById('auth-screen').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    initApp();
    showClassPicker('welcome'); // prompt for class on first load
  } else {
    document.getElementById('auth-error').style.display = 'block';
    document.getElementById('pw-input').value = '';
    document.getElementById('pw-input').focus();
  }
}

// ══════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════
function initApp() {
  buildClassNav();
  currentMode = 'create';
  document.getElementById('mode-create-btn').classList.add('active');
  document.getElementById('mode-edit-btn').classList.remove('active');
  document.getElementById('mode-drafts-btn').classList.remove('active');
  populateAppsScriptCode();
}

function buildClassNav() {
  const nav = document.getElementById('class-nav');
  nav.innerHTML = CLASSES.map(cls =>
    `<button class="class-tab${cls===currentClass?' active':''}" onclick="selectClass('${cls}')">${cls}</button>`
  ).join('');
}

function selectClass(cls) {
  currentClass    = cls;
  selectedPeriods = getDefaultPeriods(cls);
  sharedResources = [];
  blockOverrides  = {};
  editingId       = null;
  editAssignments = [];
  editSelectedId  = null;
  buildClassNav();
  renderMain();
}

function setMode(mode) {
  currentMode = mode;
  document.getElementById('mode-create-btn').classList.toggle('active',  mode==='create');
  document.getElementById('mode-edit-btn').classList.toggle('active',    mode==='edit');
  document.getElementById('mode-drafts-btn').classList.toggle('active',  mode==='drafts');
  renderMain();
}

// ══════════════════════════════════════════
//  MAIN RENDER DISPATCHER
// ══════════════════════════════════════════
function renderMain() {
  if      (currentMode === 'create') renderCreateMode();
  else if (currentMode === 'edit')   renderEditMode();
  else if (currentMode === 'drafts') renderDraftsMode();
}

// ══════════════════════════════════════════
//  CREATE MODE
// ══════════════════════════════════════════
function renderCreateMode() {
  const configured = getClassPeriods(currentClass);
  const isEditing  = !!editingId;

  let html = '';

  // ── Period selector
  html += `<div class="card">
    <div class="card-title"><span>📅</span> ${isEditing ? 'Editing assignment for' : 'Post to periods —'} <strong>${currentClass}</strong> <span class="req" style="font-size:.85em;margin-left:2px">*</span></div>
    <div class="period-grid">`;
  ALL_PERIODS.forEach(p => {
    const notConf  = configured.length > 0 && !configured.includes(p);
    const selected = selectedPeriods.includes(p);
    html += `<button class="period-btn${selected?' selected':''}${notConf?' not-configured':''}"
      data-period="${p}"
      onclick="${notConf?'':'togglePeriod(\''+p+'\')'}"
      title="${notConf?'Not configured for '+currentClass:'Period '+p}">
      ${p}
    </button>`;
  });
  html += `</div>`;
  if (configured.length === 0) {
    html += `<p class="period-hint">⚙️ No periods configured for ${currentClass} yet — open Settings to set them. At least one period must be selected before posting.</p>`;
  } else {
    html += `<p class="period-hint">Configured periods are pre-selected. Deselect any that don't apply, or click an unlit period to add it. At least one period is required.</p>`;
  }
  html += `</div>`;

  // ── Shared assignment details
  html += `<div class="card">
    <div class="card-title"><span>📝</span>Assignment Details</div>
    <div class="form-grid">
      <div class="form-group full">
        <label>Assignment Name <span class="req">*</span></label>
        <input type="text" id="f-name" placeholder="e.g. Chapter 5 Worksheet" oninput="syncOverridePreviews()">
      </div>
      <div class="form-group">
        <label>Engagement <span class="req">*</span></label>
        <select id="f-engagement">
          <option value="" disabled selected>— Select —</option>
          ${ENGAGEMENTS.map(e=>`<option>${e}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>Assignment Type <span class="req">*</span></label>
        <select id="f-atype">
          <option value="" disabled selected>— Select —</option>
          ${ASSIGNMENT_TYPES.map(t=>`<option>${t}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>Quarter <span class="req">*</span></label>
        <select id="f-quarter">
          <option value="" disabled selected>— Select —</option>
          ${QUARTERS.map(q=>`<option>${q}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>Where to Submit <span class="req">*</span></label>
        <select id="f-where">
          <option value="" disabled selected>— Select —</option>
          ${WHERE_OPTS.map(w=>`<option>${w}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>Date Assigned <span class="req">*</span></label>
        <input type="date" id="f-assigned">
      </div>
      <div class="form-group">
        <label>Date Due <span class="req">*</span></label>
        <input type="date" id="f-due" oninput="syncOverridePreviews()">
      </div>
      <div class="form-group full">
        <label>Notes <span style="font-size:.8em;font-weight:400;text-transform:none;color:var(--muted);letter-spacing:0">(optional)</span></label>
        <textarea id="f-notes" placeholder="Optional notes for students…" oninput="syncOverridePreviews()"></textarea>
      </div>
    </div>
  </div>`;

  // ── Resources
  html += `<div class="card">
    <div class="card-title"><span>🔗</span>Resources <span style="font-size:.78em;font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted)">(optional — links, videos, docs)</span></div>
    <div id="resources-container"></div>
    <button class="add-resource-btn" onclick="addResourceRow()">＋ Add Resource</button>
  </div>`;

  // ── Per-block overrides (only if periods selected)
  if (selectedPeriods.length > 0) {
    html += `<div class="card">
      <div class="card-title"><span>✏️</span>Per-Period Customization
        <span style="font-size:.78em;font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted)">— override any field for a specific period</span>
      </div>
      <div class="override-grid" id="override-grid">`;
    selectedPeriods.forEach(p => {
      html += buildOverrideCard(p);
    });
    html += `</div></div>`;
  }

  // ── Submit
  html += `<div class="card" style="background:var(--surface2)">
    <div class="submit-area">
      ${isEditing ? `<button class="btn btn-danger" onclick="cancelEdit()">Cancel Edit</button>
        <button class="btn btn-danger" onclick="deleteAssignment()">🗑 Delete</button>
        <button class="btn btn-success" onclick="submitForm(true)">💾 Save Changes</button>` :
        `<button class="btn btn-secondary" onclick="resetForm()">Clear Form</button>
        <button class="btn btn-secondary" onclick="saveDraft()" title="Save and post later">📝 Save Draft</button>
        <button class="btn btn-primary" onclick="submitForm(false)">📤 Post Assignment</button>`}
    </div>
  </div>`;

  document.getElementById('main-area').innerHTML = html;
  renderResourceRows();
  restoreFormValues();
}

function buildOverrideCard(period) {
  const ov  = blockOverrides[period] || {};
  const hasDue      = ov.dateDue      !== undefined;
  const hasAssigned = ov.dateAssigned !== undefined;
  const hasNotes    = ov.notes        !== undefined;
  const hasRes      = ov.resources    !== undefined;
  const count       = [hasDue,hasAssigned,hasNotes,hasRes].filter(Boolean).length;
  const dueVal      = hasDue      ? formatDateInput(ov.dateDue)      : '';
  const assignedVal = hasAssigned ? formatDateInput(ov.dateAssigned) : '';
  return `<div class="override-card${count>0?' has-overrides':''}" id="oc-${period}" data-period="${period}">
    <div class="override-header" onclick="toggleOverrideCard('${period}')">
      <div class="override-title">
        <span class="period-badge" data-period="${period}">Period ${period}</span>
        <span style="color:var(--muted);font-size:.85em">Customizations:</span>
        <span class="override-badges" id="ob-${period}">
          ${renderOverrideBadges(period)}
        </span>
      </div>
      <span class="chevron" id="chev-${period}">▼</span>
    </div>
    <div class="override-body" id="obody-${period}">
      <div class="form-grid" style="margin-bottom:10px">
        <div class="override-field">
          <label>
            Date Assigned
            ${hasAssigned?`<a class="reset-override" onclick="resetOverride('${period}','dateAssigned')">Reset</a>`:''}
          </label>
          <div class="override-input-wrap">
            <input type="date" id="ov-${period}-assigned" value="${assignedVal}"
              oninput="setOverride('${period}','dateAssigned',this.value)">
            ${hasAssigned?`<span class="override-indicator">✏️</span>`:''}
          </div>
        </div>
        <div class="override-field">
          <label>
            Date Due
            ${hasDue?`<a class="reset-override" onclick="resetOverride('${period}','dateDue')">Reset</a>`:''}
          </label>
          <div class="override-input-wrap">
            <input type="date" id="ov-${period}-due" value="${dueVal}"
              oninput="setOverride('${period}','dateDue',this.value)">
            ${hasDue?`<span class="override-indicator">✏️</span>`:''}
          </div>
        </div>
      </div>
      <div class="override-field">
        <label>
          Notes
          ${hasNotes?`<a class="reset-override" onclick="resetOverride('${period}','notes')">Reset</a>`:''}
        </label>
        <div class="override-input-wrap">
          <textarea id="ov-${period}-notes" oninput="setOverride('${period}','notes',this.value)" style="min-height:56px" placeholder="Leave blank to use shared notes">${ov.notes||''}</textarea>
          ${hasNotes?`<span class="override-indicator" style="top:16px;transform:none">✏️</span>`:''}
        </div>
      </div>
      <div class="override-field">
        <label>
          Resources (override)
          ${hasRes?`<a class="reset-override" onclick="resetOverride('${period}','resources')">Use shared resources</a>`:''}
        </label>
        <div id="ovres-${period}"></div>
        <button class="add-resource-btn" style="margin-top:4px" onclick="addOverrideResource('${period}')">＋ Add Period-Specific Resource</button>
        ${!hasRes?`<p style="font-size:.78em;color:var(--muted);margin-top:5px">Using shared resources. Add one above to override.</p>`:''}
      </div>
    </div>
  </div>`;
}

function renderOverrideBadges(period) {
  const ov = blockOverrides[period] || {};
  const items = [];
  if (ov.dateAssigned !== undefined) items.push(`<span class="customized-badge">Assigned ✏️</span>`);
  if (ov.dateDue      !== undefined) items.push(`<span class="customized-badge">Due date ✏️</span>`);
  if (ov.notes        !== undefined) items.push(`<span class="customized-badge">Notes ✏️</span>`);
  if (ov.resources    !== undefined) items.push(`<span class="customized-badge">Resources ✏️</span>`);
  if (items.length === 0) items.push(`<span class="default-badge">All defaults</span>`);
  return items.join('');
}

function toggleOverrideCard(period) {
  const body = document.getElementById(`obody-${period}`);
  const chev = document.getElementById(`chev-${period}`);
  const open = body.classList.toggle('open');
  chev.style.transform = open ? 'rotate(180deg)' : '';
  if (open && blockOverrides[period]?.resources !== undefined) {
    renderOverrideResources(period);
  }
}

function setOverride(period, field, value) {
  if (!blockOverrides[period]) blockOverrides[period] = {};
  if (value === '') {
    delete blockOverrides[period][field];
    if (Object.keys(blockOverrides[period]).length === 0) delete blockOverrides[period];
  } else {
    blockOverrides[period][field] = value;
  }
  refreshOverrideCardUI(period);
}

function resetOverride(period, field) {
  if (blockOverrides[period]) {
    delete blockOverrides[period][field];
    if (Object.keys(blockOverrides[period]).length === 0) delete blockOverrides[period];
  }
  // Re-render the whole card to reflect reset
  const grid = document.getElementById('override-grid');
  if (grid) {
    const existingCard = document.getElementById(`oc-${period}`);
    if (existingCard) {
      existingCard.outerHTML = buildOverrideCard(period);
    }
  }
}

function refreshOverrideCardUI(period) {
  const ov   = blockOverrides[period] || {};
  const count = Object.keys(ov).length;
  const card  = document.getElementById(`oc-${period}`);
  if (card) card.classList.toggle('has-overrides', count > 0);
  const badges = document.getElementById(`ob-${period}`);
  if (badges) badges.innerHTML = renderOverrideBadges(period);
  // Update indicators
  [{el:'assigned',key:'dateAssigned',top:''},{el:'due',key:'dateDue',top:''},{el:'notes',key:'notes',top:'16px'}].forEach(({el,key,top}) => {
    const wrap = document.querySelector(`#ov-${period}-${el}`)?.parentElement;
    if (!wrap) return;
    const existing = wrap.querySelector('.override-indicator');
    if (ov[key] !== undefined) {
      if (!existing) { const s=document.createElement('span'); s.className='override-indicator'; if(top) s.style.top=top; if(top) s.style.transform='none'; s.textContent='✏️'; wrap.appendChild(s); }
    } else { existing?.remove(); }
  });
}

