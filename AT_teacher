      <button class="topbar-icon-btn" onclick="openSettings()" title="Period Settings">⚙️</button>
      <button class="topbar-icon-btn" onclick="openSetup()" title="Apps Script Setup">🔧</button>
    </div>
  </header>

  <!-- MAIN -->
  <div class="page">
    <div class="main" id="main-area">
      <!-- content rendered here by JS -->
    </div>
