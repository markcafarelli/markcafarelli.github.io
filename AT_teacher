</div>

<!-- ═══ CLASS PICKER MODAL ═══ -->
<div class="cp-modal-bg" id="cp-modal">
  <div class="cp-box">
    <div class="cp-title" id="cp-title">Which class are you posting for?</div>
    <p class="cp-sub" id="cp-sub">Select your class to continue. You can change this any time from the top bar.</p>
    <div class="cp-grid" id="cp-grid"></div>
  </div>
</div>

<!-- ═══ SETTINGS PANEL ═══ -->
<div class="settings-overlay" id="settings-overlay" onclick="overlayClose(event)">
  <div class="settings-panel">
    <div class="settings-header">
      <span class="settings-title">⚙️ Settings</span>
      <button class="close-btn" onclick="closeSettings()">×</button>
    </div>

    <div class="settings-section">
      <div class="settings-section-title">Apps Script URL</div>
      <div class="form-group">
        <input type="url" id="setting-url" placeholder="https://script.google.com/macros/s/…/exec">
        <p class="url-note">Paste your deployed Apps Script URL here. Click 🔧 above for setup instructions.</p>
      </div>
    </div>

    <div class="settings-section">
      <div class="settings-section-title">Period Configuration</div>
      <p style="font-size:.82em;color:var(--muted);margin-bottom:12px">Select which period(s) each class meets in. You can update this once the schedule is announced.</p>
      <div id="period-config-rows"></div>
    </div>

    <div class="settings-footer">
      <button class="btn btn-secondary" onclick="closeSettings()">Cancel</button>
      <button class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
