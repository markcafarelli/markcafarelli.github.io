</div>

<!-- ═══ SETUP MODAL ═══ -->
<div class="modal-bg" id="setup-modal" onclick="setupOverlayClose(event)">
  <div class="modal-box">
    <div class="modal-top">
      <span class="modal-title">🔧 Apps Script Setup Guide</span>
      <button class="close-btn" onclick="closeSetup()">×</button>
    </div>
    <div class="modal-body-inner">

      <div class="setup-step">
        <div class="step-num">1</div>
        <div class="step-content">
          <h4>Create your Google Sheet</h4>
          <p>Create a new Google Sheet and note its ID from the URL:<br>
          <code style="background:#f1f5f9;padding:2px 6px;border-radius:4px;font-size:.85em">docs.google.com/spreadsheets/d/<strong>THIS_IS_YOUR_ID</strong>/edit</code><br>
          You do not need to create any tabs — the script will create them automatically on first use.</p>
        </div>
      </div>

      <div class="setup-step">
        <div class="step-num">2</div>
        <div class="step-content">
          <h4>Open Apps Script</h4>
