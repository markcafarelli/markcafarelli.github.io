</div>

<!-- ═══ APP ═══ -->
<div id="app" style="display:none">

  <!-- TOP BAR -->
  <header class="topbar">
    <div class="brand"><span class="brand-icon">📋</span>Assignment Portal</div>
    <nav class="class-nav" id="class-nav"></nav>
    <div class="topbar-right">
      <div class="mode-toggle">
        <button class="mode-btn active" id="mode-create-btn" onclick="onNewBtnClick()">＋ New</button>
        <button class="mode-btn" id="mode-edit-btn" onclick="setMode('edit')">✏️ Edit</button>
