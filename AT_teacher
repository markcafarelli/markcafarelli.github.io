<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assignment Portal — Teacher Tool</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f1f5f9;
  --surface: #ffffff;
  --surface2: #f8fafc;
  --border: #e2e8f0;
  --text: #1e293b;
  --muted: #64748b;
  --accent: #7c3aed;
  --accent-light: #ede9fe;
  --accent-mid: #c4b5fd;
  --nav: #0f172a;
  --nav-text: #f8fafc;
  --success: #22c55e;
  --success-bg: #f0fdf4;
  --danger: #ef4444;
  --danger-bg: #fef2f2;
  --warning: #f59e0b;
  --shadow: 0 2px 8px rgba(0,0,0,0.07);
  --radius: 10px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);font-size:17px;min-height:100vh}

/* ── AUTH ── */
#auth-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;background:linear-gradient(135deg,#1e1b4b 0%,#0f172a 60%,#1e293b 100%)}
.auth-card{background:var(--surface);border-radius:18px;padding:48px 44px;width:380px;text-align:center;box-shadow:0 24px 64px rgba(0,0,0,0.35)}
.auth-logo{font-size:2.8em;margin-bottom:14px}
.auth-title{font-family:'Outfit',sans-serif;font-size:1.7em;font-weight:800;color:var(--text);margin-bottom:4px}
.auth-sub{font-size:0.95em;color:var(--muted);margin-bottom:28px}
.auth-input{width:100%;padding:13px 16px;border:2px solid var(--border);border-radius:8px;font-size:1em;font-family:'Nunito',sans-serif;outline:none;transition:border-color .2s;margin-bottom:12px;color:var(--text)}
.auth-input:focus{border-color:var(--accent)}
.auth-btn{width:100%;padding:13px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:1em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;transition:background .2s}
.auth-btn:hover{background:#6d28d9}
.auth-error{color:var(--danger);font-size:0.9em;margin-top:10px}

/* ── TOPBAR ── */
.topbar{background:var(--nav);color:var(--nav-text);display:flex;align-items:center;gap:12px;padding:0 20px;height:62px;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,0.3)}
.brand{display:flex;align-items:center;gap:8px;font-family:'Outfit',sans-serif;font-weight:800;font-size:1.1em;white-space:nowrap;flex-shrink:0}
.brand-icon{font-size:1.3em}
.class-nav{display:flex;gap:4px;overflow-x:auto;flex:1;scrollbar-width:none}
.class-nav::-webkit-scrollbar{display:none}
.class-tab{padding:7px 14px;border-radius:6px;border:none;background:transparent;color:rgba(255,255,255,.55);font-size:0.9em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;white-space:nowrap;transition:all .2s}
.class-tab:hover{background:rgba(255,255,255,.1);color:#fff}
.class-tab.active{background:var(--accent);color:#fff}
.topbar-right{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mode-toggle{display:flex;background:rgba(255,255,255,.1);border-radius:7px;padding:3px;gap:2px}
.mode-btn{padding:6px 14px;border-radius:5px;border:none;background:transparent;color:rgba(255,255,255,.65);font-size:0.88em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap}
.mode-btn.active{background:#fff;color:var(--nav)}
.topbar-icon-btn{background:rgba(255,255,255,.1);border:none;color:rgba(255,255,255,.8);width:38px;height:38px;border-radius:7px;cursor:pointer;font-size:1.15em;transition:background .2s;display:flex;align-items:center;justify-content:center}
.topbar-icon-btn:hover{background:rgba(255,255,255,.2);color:#fff}

/* ── LAYOUT ── */
.page{display:flex;min-height:calc(100vh - 62px)}
.main{flex:1;padding:22px 26px;max-width:960px;margin:0 auto;width:100%}

/* ── SECTION CARDS ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:22px 24px;margin-bottom:16px;box-shadow:var(--shadow)}
.card-title{font-family:'Outfit',sans-serif;font-size:0.95em;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:16px;display:flex;align-items:center;gap:7px}
.card-title span{font-size:1.15em}

/* ── PERIOD SELECTOR ── */
.period-grid{display:flex;flex-wrap:wrap;gap:9px}
.period-btn{width:52px;height:52px;border:2px solid var(--border);border-radius:9px;background:var(--surface2);color:var(--muted);font-weight:800;font-size:1.1em;cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif}
.period-btn:hover{border-color:var(--accent-mid);color:var(--accent)}
.period-btn.selected{background:var(--accent);border-color:var(--accent);color:#fff}
.period-btn.not-configured{opacity:.4;cursor:not-allowed;border-style:dashed}
.period-hint{font-size:0.88em;color:var(--muted);margin-top:10px}

/* ── FORM FIELDS ── */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-grid.cols3{grid-template-columns:1fr 1fr 1fr}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group.full{grid-column:1/-1}
label{font-size:0.85em;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.req{color:var(--danger);margin-left:2px}
input[type=text],input[type=date],input[type=url],select,textarea{
  width:100%;padding:10px 13px;border:1.5px solid var(--border);border-radius:7px;
  font-size:1em;font-family:'Nunito',sans-serif;color:var(--text);background:var(--surface);
  outline:none;transition:border-color .2s;
}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
textarea{resize:vertical;min-height:76px}
select{cursor:pointer}
input::placeholder,textarea::placeholder{color:#bbb}

/* ── RESOURCES ── */
.resource-row{display:grid;grid-template-columns:1fr 2fr auto;gap:8px;align-items:center;margin-bottom:9px}
.resource-row input{margin:0}
.remove-btn{background:none;border:none;color:var(--danger);cursor:pointer;font-size:1.3em;padding:4px;line-height:1;border-radius:4px;transition:background .2s}
.remove-btn:hover{background:var(--danger-bg)}
.add-resource-btn{background:none;border:1.5px dashed var(--border);color:var(--muted);border-radius:7px;padding:9px 16px;cursor:pointer;font-size:0.9em;font-weight:700;font-family:'Nunito',sans-serif;transition:all .2s;display:inline-flex;align-items:center;gap:5px;margin-top:4px}
.add-resource-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-light)}

/* ── BLOCK OVERRIDES ── */
.override-grid{display:grid;gap:12px}
.override-card{border:1.5px solid var(--border);border-radius:9px;overflow:hidden;transition:border-color .2s}
.override-card.has-overrides{border-color:var(--accent-mid)}
.override-header{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;background:var(--surface2);cursor:pointer;user-select:none}
.override-header:hover{background:var(--border)}
.override-title{display:flex;align-items:center;gap:9px;font-weight:700;font-size:1em}
.period-badge{color:#fff;border-radius:6px;padding:4px 10px;font-size:0.85em;font-weight:800;font-family:'Outfit',sans-serif}
.period-badge[data-period="A"],.ali-period[data-period="A"],.period-btn.selected[data-period="A"]{background:#ef4444;border-color:#ef4444}
.period-badge[data-period="B"],.ali-period[data-period="B"],.period-btn.selected[data-period="B"]{background:#f97316;border-color:#f97316}
.period-badge[data-period="C"],.ali-period[data-period="C"],.period-btn.selected[data-period="C"]{background:#eab308;border-color:#eab308;color:#1e293b}
.period-badge[data-period="D"],.ali-period[data-period="D"],.period-btn.selected[data-period="D"]{background:#22c55e;border-color:#22c55e}
.period-badge[data-period="E"],.ali-period[data-period="E"],.period-btn.selected[data-period="E"]{background:#3b82f6;border-color:#3b82f6}
.period-badge[data-period="F"],.ali-period[data-period="F"],.period-btn.selected[data-period="F"]{background:#8b5cf6;border-color:#8b5cf6}
.period-badge[data-period="G"],.ali-period[data-period="G"],.period-btn.selected[data-period="G"]{background:#ec4899;border-color:#ec4899}
.period-btn.selected{color:#fff}
.override-card[data-period="A"].has-overrides{border-color:#ef4444}
.override-card[data-period="B"].has-overrides{border-color:#f97316}
.override-card[data-period="C"].has-overrides{border-color:#eab308}
.override-card[data-period="D"].has-overrides{border-color:#22c55e}
.override-card[data-period="E"].has-overrides{border-color:#3b82f6}
.override-card[data-period="F"].has-overrides{border-color:#8b5cf6}
.override-card[data-period="G"].has-overrides{border-color:#ec4899}
.override-badges{display:flex;gap:5px;align-items:center;flex-wrap:wrap}
.customized-badge{background:var(--accent-light);color:var(--accent);border-radius:99px;padding:3px 9px;font-size:0.78em;font-weight:800}
.default-badge{background:#f1f5f9;color:var(--muted);border-radius:99px;padding:3px 9px;font-size:0.78em;font-weight:700}
.chevron{transition:transform .2s;color:var(--muted);font-size:0.9em}
.override-body{padding:14px;display:none}
.override-body.open{display:block}
.override-field{margin-bottom:10px}
.override-field label{display:flex;align-items:center;justify-content:space-between}
.reset-override{font-size:0.75em;font-weight:700;color:var(--accent);cursor:pointer;text-decoration:underline;margin-left:8px}
.override-input-wrap{position:relative}
.override-indicator{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:0.72em;font-weight:800;color:var(--accent);pointer-events:none}

/* ── SUBMIT AREA ── */
.submit-area{display:flex;gap:10px;justify-content:flex-end;margin-top:4px}
.btn{padding:12px 24px;border-radius:8px;font-size:1em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;border:none;transition:all .2s;display:inline-flex;align-items:center;gap:7px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#6d28d9;transform:translateY(-1px)}
.btn-secondary{background:var(--surface);color:var(--text);border:1.5px solid var(--border)}
.btn-secondary:hover{background:var(--surface2)}
.btn-danger{background:var(--danger-bg);color:var(--danger);border:1.5px solid #fca5a5}
.btn-danger:hover{background:#fee2e2}
.btn-success{background:var(--success);color:#fff}
.btn-success:hover{background:#16a34a}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

/* ── EDIT MODE ── */
.edit-class-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:14px}
.edit-class-btn{padding:11px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface2);color:var(--muted);font-weight:700;font-size:0.85em;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s;text-align:center;line-height:1.3}
.edit-class-btn:hover{border-color:var(--accent-mid);color:var(--accent);background:var(--accent-light)}
.edit-class-btn.active{border-color:var(--accent);background:var(--accent);color:#fff}
.edit-controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.list-search{flex:2;min-width:200px;padding:10px 13px;border:1.5px solid var(--border);border-radius:7px;font-size:0.95em;font-family:'Nunito',sans-serif;outline:none;transition:border-color .2s}
.list-search:focus{border-color:var(--accent)}
.quarter-filter{display:flex;gap:6px;flex-wrap:wrap}
.qf-btn{padding:7px 14px;border:1.5px solid var(--border);border-radius:20px;background:var(--surface);color:var(--muted);font-size:0.85em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap}
.qf-btn:hover{border-color:var(--accent-mid);color:var(--accent)}
.qf-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
.empty-list{text-align:center;color:var(--muted);padding:36px 12px;font-size:0.95em}
.load-btn{padding:10px 18px;background:var(--accent-light);color:var(--accent);border:1.5px dashed var(--accent-mid);border-radius:7px;cursor:pointer;font-weight:700;font-family:'Nunito',sans-serif;font-size:0.95em;transition:all .2s;white-space:nowrap}
.load-btn:hover{background:var(--accent);color:#fff;border-style:solid}

/* Assignment cards in edit list */
.asgn-list{display:flex;flex-direction:column;gap:10px}
.asgn-card{background:var(--surface);border:1.5px solid var(--border);border-radius:10px;padding:15px 18px;display:flex;justify-content:space-between;align-items:center;gap:14px;transition:all .2s}
.asgn-card:hover{border-color:var(--accent-mid);box-shadow:0 3px 10px rgba(0,0,0,.07)}
.asgn-card.selected{border-color:var(--accent);background:var(--accent-light)}
.asgn-left{flex:1;min-width:0}
.asgn-name{font-weight:800;font-size:1em;color:var(--text);margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.asgn-tags{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:5px}
.tag{border-radius:20px;padding:3px 10px;font-size:0.75em;font-weight:700;white-space:nowrap}
.tag-q{background:#f0fdf4;color:#166534;border:1px solid #bbf7d0}
.tag-type{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe}
.tag-eng-req{background:#fef3c7;color:#92400e;border:1px solid #fde68a}
.tag-eng-opt{background:#f1f5f9;color:#475569;border:1px solid #cbd5e1}
.tag-all{background:#f5f3ff;color:#6d28d9;border:1px solid #ddd6fe}
.asgn-dates{font-size:0.82em;color:var(--muted);display:flex;gap:14px;flex-wrap:wrap}
.asgn-dates span strong{color:var(--text);font-weight:700}
.asgn-edit-btn{flex-shrink:0;background:var(--surface2);color:var(--accent);border:1.5px solid var(--accent-mid);border-radius:7px;padding:9px 16px;font-size:0.88em;font-weight:700;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s}
.asgn-edit-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

/* ── SETTINGS PANEL ── */
.settings-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;display:none;justify-content:flex-end}
.settings-overlay.open{display:flex}
.settings-panel{background:var(--surface);width:460px;max-width:95vw;height:100%;overflow-y:auto;padding:24px;box-shadow:-8px 0 24px rgba(0,0,0,.15)}
.settings-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}
.settings-title{font-family:'Outfit',sans-serif;font-size:1.25em;font-weight:800}
.close-btn{background:none;border:none;font-size:1.5em;cursor:pointer;color:var(--muted);line-height:1;padding:2px}
.close-btn:hover{color:var(--text)}
.settings-section{margin-bottom:24px}
.settings-section-title{font-size:0.86em;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid var(--border)}
.class-period-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.class-period-label{font-weight:700;font-size:0.92em;min-width:150px}
.period-toggles{display:flex;gap:5px}
.period-toggle{width:35px;height:35px;border:1.5px solid var(--border);border-radius:6px;background:var(--surface2);color:var(--muted);font-weight:800;font-size:0.82em;cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif}
.period-toggle.on{background:var(--accent);border-color:var(--accent);color:#fff}
.settings-footer{margin-top:20px;display:flex;justify-content:flex-end;gap:8px}
.url-note{font-size:0.78em;color:var(--muted);margin-top:5px}

/* ── SETUP MODAL ── */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:300;display:none;align-items:center;justify-content:center;padding:20px}
.modal-bg.open{display:flex}
.modal-box{background:var(--surface);border-radius:14px;width:680px;max-width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.3)}
.modal-top{padding:22px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.modal-title{font-family:'Outfit',sans-serif;font-size:1.15em;font-weight:800}
.modal-body-inner{padding:20px 24px}
.setup-step{display:flex;gap:14px;margin-bottom:18px}
.step-num{width:28px;height:28px;background:var(--accent);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.85em;flex-shrink:0;margin-top:2px}
.step-content h4{font-weight:700;margin-bottom:5px;font-size:0.95em}
.step-content p{font-size:0.85em;color:var(--muted);line-height:1.6}
.code-block{background:#0f172a;color:#e2e8f0;border-radius:8px;padding:14px 16px;font-family:monospace;font-size:0.78em;line-height:1.6;overflow-x:auto;margin:10px 0;position:relative}
.copy-btn{position:absolute;top:8px;right:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:5px;padding:4px 9px;cursor:pointer;font-size:0.75em;font-family:'Nunito',sans-serif;font-weight:700;transition:background .2s}
.copy-btn:hover{background:rgba(255,255,255,.2)}

/* ── TOAST ── */
.toast{position:fixed;bottom:24px;right:24px;background:#1e293b;color:#fff;padding:13px 20px;border-radius:9px;font-weight:700;font-size:0.95em;z-index:500;transform:translateY(80px);opacity:0;transition:all .3s;max-width:320px;pointer-events:none}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:#166534;border-left:4px solid var(--success)}
.toast.error{background:#7f1d1d;border-left:4px solid var(--danger)}

/* ── MISC ── */
.no-class-msg{text-align:center;color:var(--muted);padding:60px 20px}
.no-class-msg h2{font-family:'Outfit',sans-serif;font-size:1.4em;margin-bottom:8px}
.divider{border:none;border-top:1px solid var(--border);margin:4px 0 14px}

/* ── CLASS PICKER MODAL ── */
.cp-modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:400;display:none;align-items:center;justify-content:center;padding:20px}
.cp-modal-bg.open{display:flex}
.cp-box{background:var(--surface);border-radius:16px;padding:32px 28px;width:520px;max-width:100%;box-shadow:0 24px 64px rgba(0,0,0,.3);animation:modal-pop .2s ease}
.cp-title{font-family:'Outfit',sans-serif;font-size:1.3em;font-weight:800;margin-bottom:6px;text-align:center}
.cp-sub{font-size:.88em;color:var(--muted);text-align:center;margin-bottom:22px}
.cp-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cp-class-btn{padding:14px 16px;border:2px solid var(--border);border-radius:10px;background:var(--surface2);color:var(--text);font-weight:700;font-size:.95em;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s;text-align:left}
.cp-class-btn:hover{border-color:var(--accent);background:var(--accent-light);color:var(--accent)}
.cp-class-btn.selected{border-color:var(--accent);background:var(--accent);color:#fff}

/* ── EDIT CLASS SELECTOR ── */
.edit-class-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}
.edit-class-btn{padding:10px 8px;border:1.5px solid var(--border);border-radius:8px;background:var(--surface2);color:var(--muted);font-weight:700;font-size:.82em;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s;text-align:center;line-height:1.3}
.edit-class-btn:hover{border-color:var(--accent-mid);color:var(--accent);background:var(--accent-light)}
.edit-class-btn.active{border-color:var(--accent);background:var(--accent);color:#fff}

/* ── DRAFTS ── */
.draft-list{display:flex;flex-direction:column;gap:10px}
.draft-card{background:var(--surface);border:1.5px solid var(--border);border-radius:10px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;transition:border-color .2s}
.draft-card:hover{border-color:var(--accent-mid)}
.draft-info{flex:1}
.draft-name{font-weight:700;font-size:.95em;margin-bottom:3px}
.draft-meta{font-size:.78em;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.draft-class-tag{background:var(--accent-light);color:var(--accent);border-radius:5px;padding:2px 7px;font-weight:700;font-size:.75em}
.draft-actions{display:flex;gap:7px;flex-shrink:0}
.draft-empty{text-align:center;color:var(--muted);padding:40px 20px;font-size:.95em}

@media(max-width:900px){
  .edit-layout{grid-template-columns:1fr}
  .assignment-list{max-height:300px}
