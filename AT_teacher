const DRAFTS_KEY = 'ap_drafts';

function loadDraftsFromStorage() {
  try { return JSON.parse(localStorage.getItem(DRAFTS_KEY) || '[]'); }
  catch { return []; }
}
function saveDraftsToStorage(drafts) {
  localStorage.setItem(DRAFTS_KEY, JSON.stringify(drafts));
}

function saveDraft() {
  const name = document.getElementById('f-name')?.value?.trim();
  if (!name) { showToast('Add an assignment name before saving a draft.','error'); return; }

  const draft = {
    id:          'draft-' + Date.now(),
    savedAt:     new Date().toISOString(),
    className:   currentClass,
    selectedPeriods: [...selectedPeriods],
    sharedResources: [...sharedResources],
    blockOverrides:  JSON.parse(JSON.stringify(blockOverrides)),
    formData: {
      name,
      engagement:     document.getElementById('f-engagement')?.value  || '',
      assignmentType: document.getElementById('f-atype')?.value       || '',
      quarter:        document.getElementById('f-quarter')?.value     || '',
      where:    document.getElementById('f-where')?.value    || '',
      assigned: document.getElementById('f-assigned')?.value || '',
      due:      document.getElementById('f-due')?.value      || '',
      notes:    document.getElementById('f-notes')?.value    || ''
    }
  };

  const drafts = loadDraftsFromStorage();
  drafts.unshift(draft);
  saveDraftsToStorage(drafts);
  showToast(`Draft saved for ${currentClass}!`, 'success');
}

function renderDraftsMode() {
  const drafts = loadDraftsFromStorage();
  let html = `<div class="card">
    <div class="card-title"><span>📝</span>Saved Drafts</div>`;

  if (drafts.length === 0) {
    html += `<div class="draft-empty">
      No drafts saved yet.<br>
      <span style="font-size:.85em">Use "Save Draft" on the New Assignment form to save work in progress.</span>
    </div>`;
  } else {
    html += `<div class="draft-list">`;
    drafts.forEach(d => {
      const saved = new Date(d.savedAt);
      const dateStr = saved.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
      const timeStr = saved.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});
      const periods = d.selectedPeriods.length ? d.selectedPeriods.join(', ') : 'No periods selected';
      html += `<div class="draft-card">
        <div class="draft-info">
          <div class="draft-name">${esc(d.formData.name||'Untitled Draft')}</div>
          <div class="draft-meta">
            <span class="draft-class-tag">${esc(d.className)}</span>
            <span>Periods: ${periods}</span>
            ${d.formData.due ? `<span>Due: ${d.formData.due}</span>` : ''}
            <span>Saved ${dateStr} at ${timeStr}</span>
          </div>
        </div>
        <div class="draft-actions">
          <button class="btn btn-secondary" style="padding:7px 12px;font-size:.82em" onclick="loadDraft('${d.id}')">Load</button>
          <button class="btn btn-danger"    style="padding:7px 12px;font-size:.82em" onclick="deleteDraft('${d.id}')">Delete</button>
        </div>
      </div>`;
    });
    html += `</div>`;
  }
  html += `</div>`;
  document.getElementById('main-area').innerHTML = html;
}

function loadDraft(draftId) {
  const drafts = loadDraftsFromStorage();
  const draft  = drafts.find(d => d.id === draftId);
  if (!draft) { showToast('Draft not found.','error'); return; }

  // Restore state
  currentClass    = draft.className;
  selectedPeriods = draft.selectedPeriods || [];
  sharedResources = draft.sharedResources || [];
  blockOverrides  = draft.blockOverrides  || {};
  editingId       = null;

  buildClassNav();
  setMode('create');

  // Fill form fields after render
  setTimeout(() => {
    const s = (id,val) => { const el=document.getElementById(id); if(el) el.value=val; };
    const fd = draft.formData || {};
    s('f-name',       fd.name           || '');
    s('f-engagement', fd.engagement     || '');
    s('f-atype',      fd.assignmentType || '');
    s('f-quarter',    fd.quarter        || '');
    s('f-where',      fd.where          || '');
    s('f-assigned',   fd.assigned       || '');
    s('f-due',        fd.due            || '');
    s('f-notes',      fd.notes          || '');
    renderResourceRows();
    showToast(`Draft loaded for ${currentClass}.`, 'success');
  }, 60);
}

function deleteDraft(draftId) {
  if (!confirm('Delete this draft? This cannot be undone.')) return;
  const drafts = loadDraftsFromStorage().filter(d => d.id !== draftId);
  saveDraftsToStorage(drafts);
  renderDraftsMode();
  showToast('Draft deleted.','success');
}
</script>
</body>
</html>
