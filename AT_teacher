async function loadAssignments() {
  const url = getScriptUrl();
  if (!url) { showToast('Add your Apps Script URL in Settings first.','error'); return; }
  try {
    showToast('Loading…');
    const resp = await apiFetch('get', {});
    if (!resp.success) { showToast('Error: '+(resp.error||'Unknown'),'error'); return; }

    // Group rows by assignment ID
    const groups = {};
    resp.rows.forEach(row => {
      const id = row['ID'] || row.id;
      if (!groups[id]) groups[id] = [];
      groups[id].push(row);
    });

    editAssignments = Object.entries(groups).map(([id,rows]) => ({
      id,
      name:           rows[0]['Assignment Name']  || rows[0].assignmentName  || '',
      periods:        rows.map(r=>r['Block']||r.block).sort((a,b)=>ALL_PERIODS.indexOf(a)-ALL_PERIODS.indexOf(b)),
      quarter:        rows[0]['Quarter']           || rows[0].quarter         || '',
      engagement:     rows[0]['Engagement']        || rows[0].engagement      || '',
      assignmentType: rows[0]['Assignment Type']   || rows[0].assignmentType  || '',
      assigned:       formatDateInput(rows[0]['Date Assigned']||rows[0].dateAssigned||''),
      due:            formatDateInput(rows[0]['Date Due']      ||rows[0].dateDue     ||''),
      rows
    }));

    editAssignments.sort((a,b)=>a.name.localeCompare(b.name));
    showToast(`Loaded ${editAssignments.length} assignment(s).`,'success');
    renderEditMode();
  } catch(err) { showToast('Network error: '+err.message,'error'); }
}

function selectEditAssignment(id) {
  editSelectedId = id;
  const group = editAssignments.find(a=>a.id===id);
  if (!group) return;

  // Load data into create form state
  editingId       = id;
  selectedPeriods = [...group.periods];
  blockOverrides  = {};

  const first = group.rows[0];
  sharedResources = [];
  try {
    const parsed = JSON.parse(first['Resources']||first.resources||'[]');
    if (Array.isArray(parsed)) sharedResources = parsed;
  } catch {}

  // Normalize a value from the sheet for comparison
  const norm = v => String(v === null || v === undefined ? '' : v).trim();
  const normDate = v => formatDateInput(norm(v));

  const firstDue      = normDate(first['Date Due']      || first.dateDue      || '');
  const firstAssigned = normDate(first['Date Assigned'] || first.dateAssigned || '');
  const firstNotes    = norm(first['Notes'] || first.notes || '');
  const firstResStr   = norm(first['Resources'] || first.resources || '');

  // Find per-period overrides by comparing each row to the first row
  group.rows.forEach(row => {
    const p  = row['Block'] || row.block;
    const ov = {};
    const due      = normDate(row['Date Due']      || row.dateDue      || '');
    const assigned = normDate(row['Date Assigned'] || row.dateAssigned || '');
    const notes    = norm(row['Notes']    || row.notes    || '');
    const resStr   = norm(row['Resources']|| row.resources|| '');
    if (due      && due      !== firstDue)      ov.dateDue      = due;
    if (assigned && assigned !== firstAssigned) ov.dateAssigned = assigned;
    if (notes    !== firstNotes)                ov.notes        = notes;
    if (resStr   !== firstResStr && resStr !== '' && resStr !== '[]') {
      try { ov.resources = JSON.parse(resStr); } catch {}
    }
    if (Object.keys(ov).length) blockOverrides[p] = ov;
  });

  setMode('create'); // switch to create mode with form pre-filled
  // fill fields after render
  setTimeout(() => {
    const s = (id,val) => { const el=document.getElementById(id); if(el) el.value=val; };
    s('f-name',       first['Assignment Name']||first.assignmentName||'');
    s('f-engagement', first['Engagement']||first.engagement||'');
    s('f-atype',      first['Assignment Type']||first.assignmentType||'');
    s('f-quarter',    first['Quarter']||first.quarter||'');
    s('f-where',      first['Where to Submit']||first.whereToSubmit||'');
    s('f-assigned', formatDateInput(first['Date Assigned']||first.dateAssigned||''));
    s('f-due',   formatDateInput(first['Date Due']||first.dateDue||''));
    s('f-notes', first['Notes']||first.notes||'');
  }, 50);
}

function formatDateInput(str) {
  if (!str || str === '-' || str === '') return '';
  const s = String(str).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const d = new Date(s);
  if (isNaN(d)) return '';
  // Use local date parts to avoid UTC timezone shifting the day
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

