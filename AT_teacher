  if (!url) throw new Error('Apps Script URL not configured.');
  const body = JSON.stringify({ password:PASSWORD, action, className:currentClass, ...payload });
  const resp = await fetch(url, { method:'POST', headers:{'Content-Type':'text/plain'}, body });
