// ── FORM SUBMIT
async function submitForm(isUpdate) {
  const name     = document.getElementById('f-name')?.value?.trim();
  const engage   = document.getElementById('f-engagement')?.value;
  const atype    = document.getElementById('f-atype')?.value;
  const quarter  = document.getElementById('f-quarter')?.value;
  const where    = document.getElementById('f-where')?.value;
  const assigned = document.getElementById('f-assigned')?.value;
  const due      = document.getElementById('f-due')?.value;

  if (!name)                 { showToast('Assignment name is required.','error'); return; }
  if (!engage)               { showToast('Engagement is required.','error'); return; }
  if (!atype)                { showToast('Assignment Type is required.','error'); return; }
  if (!quarter)              { showToast('Quarter is required.','error'); return; }
  if (!where)                { showToast('Where to Submit is required.','error'); return; }
  if (!assigned)             { showToast('Date Assigned is required.','error'); return; }
  if (!due)                  { showToast('Date Due is required.','error'); return; }
  if (selectedPeriods.length === 0) { showToast('Select at least one period.','error'); return; }

  const url = getScriptUrl();
  if (!url) { showToast('Add your Apps Script URL in Settings (⚙️) first.','error'); return; }

  const assignedId     = isUpdate && editingId ? editingId : generateId();
  const sharedAssigned = assigned;
  const rows = selectedPeriods.map(p => {
    const ov  = blockOverrides[p] || {};
    const res = ov.resources !== undefined ? ov.resources : sharedResources;
    const filteredRes = res.filter(r => r.url);
    return {
      id:             assignedId,
      block:          p,
      assignmentName: name,
      engagement:     engage,
      assignmentType: atype,
      quarter:        quarter,
      dateAssigned:   ov.dateAssigned !== undefined ? ov.dateAssigned : sharedAssigned,
      dateDue:        ov.dateDue      !== undefined ? ov.dateDue      : due,
      whereToSubmit:  where,
      notes:          ov.notes        !== undefined ? ov.notes        : (document.getElementById('f-notes')?.value?.trim()||''),
      resources:      filteredRes.length > 0 ? JSON.stringify(filteredRes) : ''
    };
  });

  try {
    const btn = document.querySelector('.btn-primary, .btn-success');
    if (btn) { btn.disabled=true; btn.textContent='Posting…'; }
    const resp = await apiFetch(isUpdate ? 'update' : 'add', {rows});
    if (resp.success) {
      showToast(isUpdate ? 'Assignment updated!' : `Posted to ${rows.length} period(s)!`, 'success');
      resetForm();
    } else {
      showToast('Error: ' + (resp.error||'Unknown'), 'error');
    }
  } catch(err) {
    showToast('Network error: ' + err.message, 'error');
  }
}

function resetForm() {
  selectedPeriods = getDefaultPeriods(currentClass);
  sharedResources = [];
  blockOverrides  = {};
  editingId       = null;
  renderMain();
}

function cancelEdit() { resetForm(); }

async function deleteAssignment() {
  if (!editingId) return;
  if (!confirm('Delete this assignment from all periods? This cannot be undone.')) return;
  const url = getScriptUrl();
  if (!url) { showToast('Apps Script URL not set.','error'); return; }
  try {
    const resp = await apiFetch('delete', {assignmentId: editingId});
    if (resp.success) {
      showToast('Assignment deleted.','success');
      editAssignments = editAssignments.filter(a => a.id !== editingId);
      resetForm();
      setMode('edit');
    } else { showToast('Error: '+(resp.error||'Unknown'),'error'); }
  } catch(err) { showToast('Network error: '+err.message,'error'); }
}

