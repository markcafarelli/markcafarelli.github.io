}
@media(max-width:600px){
  .main{padding:14px 14px}
  .card{padding:14px 14px}
  .form-grid.cols3{grid-template-columns:1fr}
  .topbar{padding:0 12px;gap:8px}
  .resource-row{grid-template-columns:1fr 1fr auto}
}
