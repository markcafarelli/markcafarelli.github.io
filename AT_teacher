function addOverrideResource(period) {
  if (!blockOverrides[period]) blockOverrides[period] = {};
  if (!blockOverrides[period].resources) blockOverrides[period].resources = [];
  blockOverrides[period].resources.push({label:'',url:''});
  refreshOverrideCardUI(period);
  renderOverrideResources(period);
}

function setOverrideResource(period, i, key, val) {
  blockOverrides[period].resources[i][key] = val;
}
function removeOverrideResource(period, i) {
  blockOverrides[period].resources.splice(i,1);
  if (blockOverrides[period].resources.length === 0) delete blockOverrides[period].resources;
  if (Object.keys(blockOverrides[period]||{}).length === 0) delete blockOverrides[period];
  renderOverrideResources(period);
  refreshOverrideCardUI(period);
}

