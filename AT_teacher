}

function renderAssignmentCards(search='') {
  const configured = getClassPeriods(currentClass);
  const s = (search || document.getElementById('list-search')?.value || '').toLowerCase().trim();

  const filtered = editAssignments.filter(a => {
    const matchQ = quarterFilter === 'all' || a.quarter === quarterFilter;
    const matchS = !s || a.name.toLowerCase().includes(s) ||
                   (a.quarter||'').toLowerCase().includes(s) ||
                   (a.assignmentType||'').toLowerCase().includes(s);
    return matchQ && matchS;
  });

  if (!filtered.length) return `<div class="card"><div class="empty-list">No assignments match your filters.</div></div>`;

  const cards = filtered.map(a => {
    // "All Periods" logic: matches all configured periods (or all 7 if none configured)
    const ref = configured.length > 0 ? configured : ALL_PERIODS;
    const isAll = a.periods.length === ref.length && a.periods.every(p => ref.includes(p));
    const periodsHtml = isAll
      ? `<span class="tag tag-all">All Periods</span>`
      : a.periods.map(p=>`<span class="ali-period" data-period="${p}">${p}</span>`).join('');

    const qTag   = a.quarter        ? `<span class="tag tag-q">${a.quarter}</span>` : '';
    const tTag   = a.assignmentType ? `<span class="tag tag-type">${a.assignmentType}</span>` : '';
    const eTag   = a.engagement === 'Required'
                    ? `<span class="tag tag-eng-req">Required</span>`
                    : a.engagement === 'Optional'
                    ? `<span class="tag tag-eng-opt">Optional</span>` : '';

    const assignedStr = a.assigned ? `<span>Assigned <strong>${a.assigned}</strong></span>` : '';
    const dueStr      = a.due      ? `<span>Due <strong>${a.due}</strong></span>` : '';

    return `<div class="asgn-card${a.id===editSelectedId?' selected':''}" onclick="selectEditAssignment('${a.id}')">
      <div class="asgn-left">
        <div class="asgn-name">${esc(a.name)}</div>
        <div class="asgn-tags">${qTag}${tTag}${eTag}${periodsHtml}</div>
        <div class="asgn-dates">${assignedStr}${dueStr}</div>
      </div>
      <button class="asgn-edit-btn" onclick="event.stopPropagation();selectEditAssignment('${a.id}')">Edit ✏️</button>
    </div>`;
  }).join('');

  return `<div class="asgn-list">${cards}</div>`;
}

function renderAssignmentList(filter='') { return renderAssignmentCards(filter); }

function filterList() {
  const container = document.getElementById('assignment-list-container');
  if (container) container.innerHTML = renderAssignmentCards();
